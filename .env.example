# Скопіюйте у .env і вкажіть, де лежать CSV (папка, всередині якої є csv/yellow_tripdata_2024-0X.csv).
# Найшвидше - шлях у файловій системі WSL (див. README), напр. DATA_DIR=/home/<user>/taxi-data
DATA_DIR=./data
# Пам'ять драйвера Spark (local mode: драйвер = виконавець). Має бути менше за пам'ять Docker/WSL.
DRIVER_MEMORY=4g
